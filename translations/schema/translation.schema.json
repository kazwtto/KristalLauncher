{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Kristal Launcher community translation package",
  "type": "object",
  "required": [
    "schemaVersion",
    "id",
    "version",
    "name",
    "description",
    "author",
    "gameProjectId",
    "gameVersion",
    "sourceLanguage",
    "targetLanguage"
  ],
  "properties": {
    "schemaVersion": { "const": 1 },
    "id": { "type": "string", "pattern": "^[a-z0-9](?:[a-z0-9._-]{1,94}[a-z0-9])?$" },
    "version": { "type": "string", "pattern": "^[0-9]+(?:\\.[0-9]+){0,3}(?:-[0-9A-Za-z]+(?:[.-][0-9A-Za-z]+)*)?(?:\\+[0-9A-Za-z]+(?:[.-][0-9A-Za-z]+)*)?$", "maxLength": 64 },
    "name": { "$ref": "#/$defs/localized" },
    "description": { "$ref": "#/$defs/localized" },
    "author": { "type": "string" },
    "gameProjectId": { "type": "string", "pattern": "^[A-Za-z0-9](?:[A-Za-z0-9._-]{0,94}[A-Za-z0-9])?$" },
    "gameVersion": { "type": "string", "minLength": 1, "maxLength": 64 },
    "sourceLanguage": { "type": "string", "pattern": "^[A-Za-z]{2,8}(?:-[A-Za-z0-9]{1,8})*$", "maxLength": 32 },
    "targetLanguage": { "type": "string", "pattern": "^[A-Za-z]{2,8}(?:-[A-Za-z0-9]{1,8})*$", "maxLength": 32 },
    "minimumLauncherVersion": { "type": "string", "pattern": "^[0-9]+(?:\\.[0-9]+){0,3}(?:-[0-9A-Za-z]+(?:[.-][0-9A-Za-z]+)*)?(?:\\+[0-9A-Za-z]+(?:[.-][0-9A-Za-z]+)*)?$", "maxLength": 64 },
    "textsFile": { "const": "texts.json" },
    "textsSha256": { "type": "string", "pattern": "^[a-fA-F0-9]{64}$" },
    "files": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["source", "target", "sourceSha256", "translatedSha256"],
        "properties": {
          "source": { "type": "string" },
          "target": { "type": "string", "pattern": "^scripts/.+\\.lua$" },
          "sourceSha256": { "type": "string", "pattern": "^[a-fA-F0-9]{64}$" },
          "translatedSha256": { "type": "string", "pattern": "^[a-fA-F0-9]{64}$" }
        }
      }
    }
  },
  "anyOf": [
    { "required": ["textsFile", "textsSha256"] },
    { "required": ["files"] }
  ],
  "$defs": {
    "localized": {
      "oneOf": [
        { "type": "string" },
        {
          "type": "object",
          "additionalProperties": { "type": "string" },
          "minProperties": 1
        }
      ]
    }
  }
}
