<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="10dp"
    app:cardBackgroundColor="?attr/kristalPatchCardColor"
    app:cardCornerRadius="?attr/kristalCorner14"
    app:cardElevation="0dp"
    app:strokeWidth="0dp">

    <LinearLayout
        android:id="@+id/gamePatchCardContent"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="14dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/tvGamePatchName"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:textColor="?attr/colorOnSurface"
                android:textSize="15sp"
                android:textStyle="bold" />

            <LinearLayout
                android:id="@+id/gamePatchRecommendedBadge"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center_vertical"
                android:minHeight="32dp"
                android:orientation="horizontal"
                android:paddingHorizontal="3dp"
                android:visibility="gone">

                <ImageView
                    android:id="@+id/gamePatchRecommendedIcon"
                    android:layout_width="16dp"
                    android:layout_height="16dp"
                    android:contentDescription="@string/patch_recommended"
                    android:src="?attr/kristalIconWarning" />

                <TextView
                    android:id="@+id/gamePatchRecommendedLabel"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="3dp"
                    android:text="@string/patch_recommended"
                    android:textSize="11sp"
                    android:textStyle="bold" />
            </LinearLayout>
        </LinearLayout>

        <TextView
            android:id="@+id/tvGamePatchDescription"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="3dp"
            android:ellipsize="end"
            android:maxLines="2"
            android:textColor="?attr/colorOnSurfaceVariant"
            android:textSize="12sp" />

        <kwz.love2d.launcher.ui.PatchSegmentedButtonGroup
            android:id="@+id/gamePatchModeGroup"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            app:selectionRequired="true"
            app:singleSelection="true">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnGamePatchInherit"
                style="@style/Widget.Material3.Button.OutlinedButton"
                android:layout_width="0dp"
                android:layout_height="44dp"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                app:cornerRadius="?attr/kristalCorner20"
                android:layout_weight="1"
                android:text="@string/patch_mode_inherit"
                android:textSize="11sp"
                android:textColor="@color/segmented_button_text"
                app:backgroundTint="@color/segmented_button_background"
                app:strokeWidth="0dp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnGamePatchEnabled"
                style="@style/Widget.Material3.Button.OutlinedButton"
                android:layout_width="0dp"
                android:layout_height="44dp"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                app:cornerRadius="?attr/kristalCorner20"
                android:layout_weight="1"
                android:text="@string/patch_mode_enable"
                android:textSize="11sp"
                android:textColor="@color/segmented_button_text"
                app:backgroundTint="@color/segmented_button_background"
                app:strokeWidth="0dp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnGamePatchDisabled"
                style="@style/Widget.Material3.Button.OutlinedButton"
                android:layout_width="0dp"
                android:layout_height="44dp"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                app:cornerRadius="?attr/kristalCorner20"
                android:layout_weight="1"
                android:text="@string/patch_mode_disable"
                android:textSize="11sp"
                android:textColor="@color/segmented_button_text"
                app:backgroundTint="@color/segmented_button_background"
                app:strokeWidth="0dp" />
        </kwz.love2d.launcher.ui.PatchSegmentedButtonGroup>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnGamePatchAction"
            style="@style/Widget.Material3.Button.OutlinedButton"
            android:layout_width="match_parent"
            android:layout_height="44dp"
            android:layout_marginTop="8dp"
            android:text="@string/patch_download"
            android:visibility="gone"
            app:cornerRadius="?attr/kristalCorner20" />
    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
