<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingBottom="32dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="64dp"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingHorizontal="16dp">

            <ImageView
                android:id="@+id/btnBack"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="@string/navigate_back"
                android:padding="8dp"
                android:src="@drawable/ic_arrow_back"
                app:tint="@color/m3_on_surface" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:text="@string/appearance_title"
                android:textColor="@color/m3_on_surface"
                android:textSize="20sp"
                android:textStyle="bold" />
        </LinearLayout>

        <TextView
            android:id="@+id/appearanceSummary"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="20dp"
            android:layout_marginTop="8dp"
            android:lineSpacingExtra="2dp"
            android:text="@string/appearance_summary"
            android:textColor="@color/m3_on_surface_variant"
            android:textSize="14sp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="20dp"
            android:layout_marginTop="24dp"
            android:layout_marginBottom="10dp"
            android:text="@string/theme_title"
            android:textColor="@color/m3_primary"
            android:textSize="12sp"
            android:textStyle="bold" />

        <LinearLayout
            android:id="@+id/themeOptions"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="16dp"
            android:orientation="vertical">

            <com.google.android.material.card.MaterialCardView
                android:id="@+id/themeDeviceCard"
                style="@style/SettingsChoiceCard">

                <LinearLayout style="@style/SettingsChoiceRow">
                    <ImageView
                        style="@style/SettingsChoiceIcon"
                        android:contentDescription="@null"
                        android:src="@drawable/ic_device" />
                    <TextView
                        style="@style/SettingsChoiceLabel"
                        android:text="@string/theme_device_option" />
                    <com.google.android.material.radiobutton.MaterialRadioButton
                        android:id="@+id/themeDevice"
                        style="@style/SettingsChoiceRadio" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <com.google.android.material.card.MaterialCardView
                android:id="@+id/themeLightCard"
                style="@style/SettingsChoiceCard.Spaced">

                <LinearLayout style="@style/SettingsChoiceRow">
                    <ImageView
                        style="@style/SettingsChoiceIcon"
                        android:contentDescription="@null"
                        android:src="@drawable/ic_light_mode" />
                    <TextView
                        style="@style/SettingsChoiceLabel"
                        android:text="@string/theme_light_option" />
                    <com.google.android.material.radiobutton.MaterialRadioButton
                        android:id="@+id/themeLight"
                        style="@style/SettingsChoiceRadio" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <com.google.android.material.card.MaterialCardView
                android:id="@+id/themeDarkCard"
                style="@style/SettingsChoiceCard.Spaced">

                <LinearLayout style="@style/SettingsChoiceRow">
                    <ImageView
                        style="@style/SettingsChoiceIcon"
                        android:contentDescription="@null"
                        android:src="@drawable/ic_dark_mode" />
                    <TextView
                        style="@style/SettingsChoiceLabel"
                        android:text="@string/theme_dark_option" />
                    <com.google.android.material.radiobutton.MaterialRadioButton
                        android:id="@+id/themeDark"
                        style="@style/SettingsChoiceRadio" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>
        </LinearLayout>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="20dp"
            android:layout_marginTop="24dp"
            android:layout_marginBottom="10dp"
            android:text="@string/motion_title"
            android:textColor="@color/m3_primary"
            android:textSize="12sp"
            android:textStyle="bold" />

        <com.google.android.material.card.MaterialCardView
            android:id="@+id/motionCard"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="16dp"
            android:clickable="true"
            android:focusable="true"
            android:foreground="?attr/selectableItemBackground"
            app:cardBackgroundColor="@color/m3_surface_card"
            app:cardCornerRadius="16dp"
            app:cardElevation="0dp"
            app:strokeColor="@color/m3_outline"
            app:strokeWidth="1dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:padding="16dp">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:paddingStart="0dp"
                    android:paddingEnd="12dp">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/animations_enabled"
                        android:textColor="@color/m3_on_surface"
                        android:textSize="15sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="3dp"
                        android:lineSpacingExtra="1dp"
                        android:text="@string/animations_summary"
                        android:textColor="@color/m3_on_surface_variant"
                        android:textSize="13sp" />
                </LinearLayout>

                <com.google.android.material.materialswitch.MaterialSwitch
                    android:id="@+id/switchAnimations"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:contentDescription="@string/animations_enabled" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>
    </LinearLayout>
</ScrollView>
