<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingBottom="32dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="64dp"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingHorizontal="16dp">

            <ImageView
                android:id="@+id/btnBack"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="@string/navigate_back"
                android:padding="8dp"
                android:src="?attr/kristalIconArrowBack"
                app:tint="?attr/colorOnSurface" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:text="@string/appearance_title"
                android:textColor="?attr/colorOnSurface"
                android:textSize="20sp"
                android:textStyle="bold" />
        </LinearLayout>

        <TextView
            android:id="@+id/appearanceSummary"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="20dp"
            android:layout_marginTop="8dp"
            android:lineSpacingExtra="2dp"
            android:text="@string/appearance_summary"
            android:textColor="?attr/colorOnSurfaceVariant"
            android:textSize="14sp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="20dp"
            android:layout_marginTop="24dp"
            android:layout_marginBottom="10dp"
            android:text="@string/theme_title"
            android:textColor="?attr/colorPrimary"
            android:textSize="12sp"
            android:textStyle="bold" />

        <LinearLayout
            android:id="@+id/themeOptions"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="16dp"
            android:orientation="vertical">

            <com.google.android.material.card.MaterialCardView
                android:id="@+id/themeDeviceCard"
                style="@style/SettingsChoiceCard">

                <LinearLayout style="@style/SettingsChoiceRow">
                    <ImageView
                        style="@style/SettingsChoiceIcon"
                        android:contentDescription="@null"
                        android:src="?attr/kristalIconDevice" />
                    <TextView
                        style="@style/SettingsChoiceLabel"
                        android:text="@string/theme_device_option" />
                    <com.google.android.material.radiobutton.MaterialRadioButton
                        android:id="@+id/themeDevice"
                        style="@style/SettingsChoiceRadio" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <com.google.android.material.card.MaterialCardView
                android:id="@+id/themeLightCard"
                style="@style/SettingsChoiceCard.Spaced">

                <LinearLayout style="@style/SettingsChoiceRow">
                    <ImageView
                        style="@style/SettingsChoiceIcon"
                        android:contentDescription="@null"
                        android:src="?attr/kristalIconLightMode" />
                    <TextView
                        style="@style/SettingsChoiceLabel"
                        android:text="@string/theme_light_option" />
                    <com.google.android.material.radiobutton.MaterialRadioButton
                        android:id="@+id/themeLight"
                        style="@style/SettingsChoiceRadio" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <com.google.android.material.card.MaterialCardView
                android:id="@+id/themeDarkCard"
                style="@style/SettingsChoiceCard.Spaced">

                <LinearLayout style="@style/SettingsChoiceRow">
                    <ImageView
                        style="@style/SettingsChoiceIcon"
                        android:contentDescription="@null"
                        android:src="?attr/kristalIconDarkMode" />
                    <TextView
                        style="@style/SettingsChoiceLabel"
                        android:text="@string/theme_dark_option" />
                    <com.google.android.material.radiobutton.MaterialRadioButton
                        android:id="@+id/themeDark"
                        style="@style/SettingsChoiceRadio" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <com.google.android.material.card.MaterialCardView
                android:id="@+id/themeDeltaruneCard"
                style="@style/SettingsChoiceCard.Spaced"
                android:layout_height="wrap_content">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <LinearLayout
                        android:id="@+id/themeDeltaruneRow"
                        style="@style/SettingsChoiceRow"
                        android:layout_height="64dp">

                        <ImageView
                            style="@style/SettingsChoiceIcon"
                            android:contentDescription="@null"
                            android:src="@drawable/pixel_heart" />

                        <TextView
                            style="@style/SettingsChoiceLabel"
                            android:text="@string/theme_deltarune_option" />

                        <com.google.android.material.radiobutton.MaterialRadioButton
                            android:id="@+id/themeDeltarune"
                            style="@style/SettingsChoiceRadio" />
                    </LinearLayout>

                    <LinearLayout
                        android:id="@+id/deltaruneAmoledOptions"
                        android:layout_width="match_parent"
                        android:layout_height="56dp"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:paddingStart="16dp"
                        android:paddingEnd="16dp"
                        android:visibility="gone">

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="AMOLED"
                            android:textColor="?attr/colorOnSurface"
                            android:textSize="14sp"
                            android:textStyle="bold" />

                        <kwz.love2d.launcher.ui.DeltaruneSquareSwitch
                            android:id="@+id/switchDeltaruneAmoled"
                            android:layout_width="44dp"
                            android:layout_height="24dp"
                            android:contentDescription="AMOLED" />
                    </LinearLayout>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>
        </LinearLayout>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="20dp"
            android:layout_marginTop="24dp"
            android:layout_marginBottom="10dp"
            android:text="@string/motion_title"
            android:textColor="?attr/colorPrimary"
            android:textSize="12sp"
            android:textStyle="bold" />

        <com.google.android.material.card.MaterialCardView
            android:id="@+id/motionCard"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="16dp"
            android:clickable="true"
            android:focusable="true"
            android:foreground="?attr/selectableItemBackground"
            app:cardBackgroundColor="?attr/colorSurface"
            app:cardCornerRadius="?attr/kristalCorner16"
            app:cardElevation="0dp"
            app:strokeColor="?attr/colorOutline"
            app:strokeWidth="1dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:padding="16dp">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:paddingEnd="12dp">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/animations_enabled"
                        android:textColor="?attr/colorOnSurface"
                        android:textSize="15sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="3dp"
                        android:lineSpacingExtra="1dp"
                        android:text="@string/animations_summary"
                        android:textColor="?attr/colorOnSurfaceVariant"
                        android:textSize="13sp" />
                </LinearLayout>

                <com.google.android.material.materialswitch.MaterialSwitch
                    android:id="@+id/switchAnimations"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:contentDescription="@string/animations_enabled" />

                <kwz.love2d.launcher.ui.DeltaruneSquareSwitch
                    android:id="@+id/switchAnimationsDeltarune"
                    android:layout_width="44dp"
                    android:layout_height="24dp"
                    android:contentDescription="@string/animations_enabled"
                    android:visibility="gone" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>
    </LinearLayout>
</ScrollView>
