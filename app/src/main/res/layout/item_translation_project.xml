<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="10dp"
    android:checkable="true"
    android:clickable="true"
    android:focusable="true"
    android:foreground="?attr/selectableItemBackground"
    app:cardBackgroundColor="@color/segmented_button_background"
    app:cardCornerRadius="?attr/kristalCorner16"
    app:cardElevation="0dp"
    app:checkedIcon="@null"
    app:strokeColor="@color/segmented_button_stroke"
    app:strokeWidth="1dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:padding="14dp">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tvTranslationLanguage"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:duplicateParentState="true"
                android:textColor="@color/segmented_button_text"
                android:textSize="15sp"
                android:textStyle="bold"
                tools:text="Português (Brasil)" />

            <TextView
                android:id="@+id/tvTranslationProgress"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="3dp"
                android:textColor="?attr/colorOnSurfaceVariant"
                android:textSize="12sp"
                tools:text="42 / 120 translated" />
        </LinearLayout>

        <ImageButton
            android:id="@+id/btnTranslationVersionWarning"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/translation_version_warning_title"
            android:padding="10dp"
            android:src="?attr/kristalIconWarning"
            android:visibility="gone"
            app:tint="?attr/colorError"
            tools:visibility="visible" />

        <ImageButton
            android:id="@+id/btnEditTranslation"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/translation_edit"
            android:padding="10dp"
            android:scaleX="-1"
            android:src="?attr/kristalIconArrowBack"
            app:tint="?attr/colorOnSurfaceVariant" />

        <ImageButton
            android:id="@+id/btnDownloadTranslation"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/translation_download"
            android:padding="10dp"
            android:src="?attr/kristalIconImport"
            android:visibility="gone"
            app:tint="?attr/colorPrimary" />
    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
