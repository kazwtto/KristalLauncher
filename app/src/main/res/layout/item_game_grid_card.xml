<?xml version="1.0" encoding="utf-8"?>
<kwz.love2d.launcher.ui.SquareMaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_margin="6dp"
    android:clickable="true"
    android:focusable="true"
    android:foreground="?attr/selectableItemBackground"
    app:cardBackgroundColor="?attr/colorSurface"
    app:cardCornerRadius="?attr/kristalCorner16"
    app:cardElevation="0dp"
    app:strokeColor="?attr/colorOutline"
    app:strokeWidth="1dp">

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <View
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@drawable/bg_grid_banner" />

        <kwz.love2d.launcher.ui.LayeredPreviewView
            android:id="@+id/ivGamePreview"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:contentDescription="@null"
            android:visibility="gone" />

        <View
            android:id="@+id/gamePreviewScrim"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@drawable/scrim_bottom_gradient" />

        <androidx.appcompat.widget.AppCompatImageView
            android:id="@+id/ivGameIcon"
            android:layout_width="76dp"
            android:layout_height="76dp"
            android:layout_gravity="top|center_horizontal"
            android:layout_marginTop="28dp"
            android:scaleType="centerCrop"
            android:src="@drawable/ic_launcher" />

        <ImageView
            android:id="@+id/btnMenuMore"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:layout_gravity="top|end"
            android:layout_margin="4dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/more_options"
            android:padding="4dp"
            android:src="?attr/kristalIconMore"
            app:tint="?attr/colorOnSurface" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="bottom"
            android:orientation="vertical"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"
            android:paddingBottom="12dp">

            <TextView
                android:id="@+id/tvGameTitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxLines="2"
                android:shadowColor="#66000000"
                android:shadowDx="0"
                android:shadowDy="1"
                android:shadowRadius="2"
                android:textColor="?attr/colorOnSurface"
                android:textSize="14sp"
                android:textStyle="bold"
                tools:text="Frostveil" />

            <TextView
                android:id="@+id/tvSubtitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:ellipsize="end"
                android:maxLines="1"
                android:textColor="?attr/colorOnSurfaceVariant"
                android:textSize="11sp"
                android:visibility="gone"
                tools:text="Weird Route"
                tools:visibility="visible" />

            <LinearLayout
                android:id="@+id/gameTagsContainer"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:gravity="start|center_vertical"
                android:orientation="horizontal"
                android:visibility="gone">

                <TextView
                    android:id="@+id/tvVersion"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="5dp"
                    android:background="@drawable/bg_badge_demo"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:paddingHorizontal="5dp"
                    android:paddingVertical="1dp"
                    android:textColor="?attr/colorOnSecondaryContainer"
                    android:textSize="11sp"
                    android:textStyle="bold"
                    android:visibility="gone"
                    app:backgroundTint="?attr/colorSecondaryContainer"
                    tools:text="v1.3.2"
                    tools:visibility="visible" />

                <TextView
                    android:id="@+id/tvEngineVer"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:background="@drawable/bg_badge_demo"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:paddingHorizontal="5dp"
                    android:paddingVertical="1dp"
                    android:textColor="?attr/colorOnTertiaryContainer"
                    android:textSize="11sp"
                    android:textStyle="bold"
                    android:visibility="gone"
                    app:backgroundTint="?attr/colorTertiaryContainer"
                    tools:text="Kristal v0.10.0-dev"
                    tools:visibility="visible" />
            </LinearLayout>
        </LinearLayout>
    </FrameLayout>
</kwz.love2d.launcher.ui.SquareMaterialCardView>
