<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/tutorialRoot"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingStart="20dp"
    android:paddingTop="16dp"
    android:paddingEnd="20dp"
    android:paddingBottom="0dp">

    <LinearLayout
        android:id="@+id/tutorialHeader"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <ImageView
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="@drawable/bg_primary_icon_frame"
            android:contentDescription="@null"
            android:padding="9dp"
            android:src="@drawable/ic_help_outline"
            app:tint="@color/m3_on_primary" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/tutorial_quick_guide"
                android:textAllCaps="true"
                android:textColor="@color/m3_primary"
                android:textSize="11sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="1dp"
                android:text="@string/tutorial_dialog_title"
                android:textColor="@color/m3_on_surface"
                android:textSize="18sp"
                android:textStyle="bold" />

        </LinearLayout>

        <ImageButton
            android:id="@+id/btnTutorialClose"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/tutorial_close"
            android:padding="10dp"
            android:src="@drawable/ic_close"
            app:tint="@color/m3_on_surface_variant" />

    </LinearLayout>

    <TextView
        android:id="@+id/tvTutorialStep"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="18dp"
        android:background="@drawable/bg_tutorial_step"
        android:paddingStart="10dp"
        android:paddingTop="5dp"
        android:paddingEnd="10dp"
        android:paddingBottom="5dp"
        android:textColor="@color/m3_on_primary_container"
        android:textSize="12sp"
        android:textStyle="bold" />

    <ViewFlipper
        android:id="@+id/tutorialFlipper"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:animateFirstView="false">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <com.google.android.material.card.MaterialCardView
                    android:layout_width="match_parent"
                    android:layout_height="184dp"
                    android:importantForAccessibility="noHideDescendants"
                    app:cardBackgroundColor="@color/m3_surface_variant"
                    app:cardCornerRadius="22dp"
                    app:cardElevation="0dp"
                    app:strokeColor="@color/m3_outline"
                    app:strokeWidth="1dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:padding="12dp">

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="match_parent"
                            android:layout_marginEnd="10dp"
                            android:layout_weight="1"
                            android:gravity="center_vertical"
                            android:orientation="vertical"
                            android:paddingHorizontal="4dp">

                            <View
                                android:layout_width="78dp"
                                android:layout_height="8dp"
                                android:background="@color/m3_outline" />

                            <View
                                android:layout_width="54dp"
                                android:layout_height="8dp"
                                android:layout_marginTop="7dp"
                                android:background="@color/m3_outline" />

                            <View
                                android:layout_width="88dp"
                                android:layout_height="8dp"
                                android:layout_marginTop="24dp"
                                android:background="@color/m3_outline" />

                            <View
                                android:layout_width="62dp"
                                android:layout_height="8dp"
                                android:layout_marginTop="7dp"
                                android:background="@color/m3_outline" />

                            <View
                                android:layout_width="88dp"
                                android:layout_height="8dp"
                                android:layout_marginTop="24dp"
                                android:background="@color/m3_outline" />

                            <View
                                android:layout_width="48dp"
                                android:layout_height="8dp"
                                android:layout_marginTop="7dp"
                                android:background="@color/m3_outline" />

                        </LinearLayout>

                        <com.google.android.material.card.MaterialCardView
                            android:layout_width="126dp"
                            android:layout_height="160dp"
                            app:cardBackgroundColor="@color/m3_surface_card"
                            app:cardCornerRadius="16dp"
                            app:cardElevation="0dp"
                            app:strokeColor="@color/m3_outline"
                            app:strokeWidth="1dp">

                            <LinearLayout
                                android:layout_width="match_parent"
                                android:layout_height="match_parent"
                                android:orientation="vertical">

                                <View
                                    android:layout_width="match_parent"
                                    android:layout_height="9dp"
                                    android:background="@color/m3_primary" />

                                <ImageView
                                    android:layout_width="52dp"
                                    android:layout_height="52dp"
                                    android:layout_gravity="center_horizontal"
                                    android:layout_marginTop="22dp"
                                    android:contentDescription="@null"
                                    android:src="@drawable/ic_folder"
                                    app:tint="@color/m3_primary" />

                                <TextView
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:layout_marginStart="10dp"
                                    android:layout_marginTop="14dp"
                                    android:layout_marginEnd="10dp"
                                    android:background="@drawable/bg_tutorial_mock_button"
                                    android:gravity="center"
                                    android:paddingVertical="8dp"
                                    android:text="@string/tutorial_mock_games_folder"
                                    android:textColor="@color/m3_on_primary"
                                    android:textSize="10sp"
                                    android:textStyle="bold" />

                            </LinearLayout>

                        </com.google.android.material.card.MaterialCardView>

                    </LinearLayout>

                </com.google.android.material.card.MaterialCardView>

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="18dp"
                    android:text="@string/tutorial_step_1_title"
                    android:textColor="@color/m3_on_surface"
                    android:textSize="21sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:lineSpacingExtra="2dp"
                    android:text="@string/tutorial_step_1_body"
                    android:textColor="@color/m3_on_surface_variant"
                    android:textSize="15sp" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:background="@drawable/bg_tutorial_tip"
                    android:padding="12dp"
                    android:text="@string/tutorial_step_1_tip"
                    android:textColor="@color/m3_on_primary_container"
                    android:textSize="13sp" />

            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <com.google.android.material.card.MaterialCardView
                    android:layout_width="match_parent"
                    android:layout_height="184dp"
                    android:importantForAccessibility="noHideDescendants"
                    app:cardBackgroundColor="@color/m3_surface_variant"
                    app:cardCornerRadius="22dp"
                    app:cardElevation="0dp"
                    app:strokeColor="@color/m3_outline"
                    app:strokeWidth="1dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:orientation="vertical"
                        android:padding="14dp">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="34dp"
                            android:gravity="center_vertical"
                            android:orientation="horizontal">

                            <ImageView
                                android:layout_width="24dp"
                                android:layout_height="24dp"
                                android:contentDescription="@null"
                                android:src="@drawable/ic_folder"
                                app:tint="@color/m3_primary" />

                            <TextView
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="9dp"
                                android:layout_weight="1"
                                android:text="@string/tutorial_mock_games_path"
                                android:textColor="@color/m3_on_surface"
                                android:textSize="13sp"
                                android:textStyle="bold" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="@string/tutorial_mock_check"
                                android:textColor="@color/m3_primary"
                                android:textSize="16sp"
                                android:textStyle="bold" />

                        </LinearLayout>

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="0dp"
                            android:layout_marginTop="8dp"
                            android:layout_weight="1"
                            android:orientation="vertical">

                            <LinearLayout
                                android:layout_width="match_parent"
                                android:layout_height="40dp"
                                android:background="@drawable/bg_tutorial_file_row"
                                android:gravity="center_vertical"
                                android:orientation="horizontal"
                                android:paddingHorizontal="10dp">

                                <TextView
                                    android:layout_width="44dp"
                                    android:layout_height="24dp"
                                    android:background="@drawable/bg_tutorial_extension"
                                    android:gravity="center"
                                    android:text="@string/tutorial_mock_extension_love"
                                    android:textColor="@color/m3_on_primary_container"
                                    android:textSize="9sp"
                                    android:textStyle="bold" />

                                <TextView
                                    android:layout_width="0dp"
                                    android:layout_height="wrap_content"
                                    android:layout_marginStart="10dp"
                                    android:layout_weight="1"
                                    android:text="@string/tutorial_mock_file_love"
                                    android:textColor="@color/m3_on_surface"
                                    android:textSize="12sp"
                                    android:textStyle="bold" />

                            </LinearLayout>

                            <LinearLayout
                                android:layout_width="match_parent"
                                android:layout_height="40dp"
                                android:layout_marginTop="5dp"
                                android:background="@drawable/bg_tutorial_file_row"
                                android:gravity="center_vertical"
                                android:orientation="horizontal"
                                android:paddingHorizontal="10dp">

                                <TextView
                                    android:layout_width="44dp"
                                    android:layout_height="24dp"
                                    android:background="@drawable/bg_tutorial_extension"
                                    android:gravity="center"
                                    android:text="@string/tutorial_mock_extension_zip"
                                    android:textColor="@color/m3_on_primary_container"
                                    android:textSize="9sp"
                                    android:textStyle="bold" />

                                <TextView
                                    android:layout_width="0dp"
                                    android:layout_height="wrap_content"
                                    android:layout_marginStart="10dp"
                                    android:layout_weight="1"
                                    android:text="@string/tutorial_mock_file_zip"
                                    android:textColor="@color/m3_on_surface"
                                    android:textSize="12sp"
                                    android:textStyle="bold" />

                            </LinearLayout>

                            <LinearLayout
                                android:layout_width="match_parent"
                                android:layout_height="40dp"
                                android:layout_marginTop="5dp"
                                android:background="@drawable/bg_tutorial_file_row"
                                android:gravity="center_vertical"
                                android:orientation="horizontal"
                                android:paddingHorizontal="10dp">

                                <TextView
                                    android:layout_width="44dp"
                                    android:layout_height="24dp"
                                    android:background="@drawable/bg_tutorial_extension"
                                    android:gravity="center"
                                    android:text="@string/tutorial_mock_extension_exe"
                                    android:textColor="@color/m3_on_primary_container"
                                    android:textSize="9sp"
                                    android:textStyle="bold" />

                                <TextView
                                    android:layout_width="0dp"
                                    android:layout_height="wrap_content"
                                    android:layout_marginStart="10dp"
                                    android:layout_weight="1"
                                    android:text="@string/tutorial_mock_file_exe"
                                    android:textColor="@color/m3_on_surface"
                                    android:textSize="12sp"
                                    android:textStyle="bold" />

                            </LinearLayout>

                        </LinearLayout>

                    </LinearLayout>

                </com.google.android.material.card.MaterialCardView>

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="18dp"
                    android:text="@string/tutorial_step_2_title"
                    android:textColor="@color/m3_on_surface"
                    android:textSize="21sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:lineSpacingExtra="2dp"
                    android:text="@string/tutorial_step_2_body"
                    android:textColor="@color/m3_on_surface_variant"
                    android:textSize="15sp" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:background="@drawable/bg_tutorial_tip"
                    android:padding="12dp"
                    android:text="@string/tutorial_step_2_tip"
                    android:textColor="@color/m3_on_primary_container"
                    android:textSize="13sp" />

            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <com.google.android.material.card.MaterialCardView
                    android:layout_width="match_parent"
                    android:layout_height="184dp"
                    android:importantForAccessibility="noHideDescendants"
                    app:cardBackgroundColor="@color/m3_surface_variant"
                    app:cardCornerRadius="22dp"
                    app:cardElevation="0dp"
                    app:strokeColor="@color/m3_outline"
                    app:strokeWidth="1dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:orientation="vertical"
                        android:padding="14dp">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="34dp"
                            android:background="@drawable/bg_tutorial_file_row"
                            android:gravity="center_vertical"
                            android:orientation="horizontal"
                            android:paddingHorizontal="10dp">

                            <ImageView
                                android:layout_width="16dp"
                                android:layout_height="16dp"
                                android:contentDescription="@null"
                                android:src="@drawable/ic_search"
                                app:tint="@color/m3_on_surface_variant" />

                            <View
                                android:layout_width="74dp"
                                android:layout_height="7dp"
                                android:layout_marginStart="8dp"
                                android:background="@color/m3_outline" />

                        </LinearLayout>

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="0dp"
                            android:layout_weight="1"
                            android:gravity="center"
                            android:orientation="vertical">

                            <ImageView
                                android:layout_width="48dp"
                                android:layout_height="48dp"
                                android:contentDescription="@null"
                                android:src="@drawable/ic_folder"
                                app:tint="@color/m3_on_surface_variant" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="6dp"
                                android:text="@string/tutorial_mock_empty_library"
                                android:textColor="@color/m3_on_surface"
                                android:textSize="12sp"
                                android:textStyle="bold" />

                            <com.google.android.material.button.MaterialButton
                                android:layout_width="wrap_content"
                                android:layout_height="40dp"
                                android:layout_marginTop="10dp"
                                android:clickable="false"
                                android:focusable="false"
                                android:minHeight="0dp"
                                android:text="@string/select_folder"
                                android:textColor="@color/m3_on_primary"
                                android:textSize="11sp"
                                app:backgroundTint="@color/m3_primary"
                                app:cornerRadius="20dp"
                                app:icon="@drawable/ic_folder"
                                app:iconSize="16dp"
                                app:iconTint="@color/m3_on_primary" />

                        </LinearLayout>

                    </LinearLayout>

                </com.google.android.material.card.MaterialCardView>

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="18dp"
                    android:text="@string/tutorial_step_3_title"
                    android:textColor="@color/m3_on_surface"
                    android:textSize="21sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:lineSpacingExtra="2dp"
                    android:text="@string/tutorial_step_3_body"
                    android:textColor="@color/m3_on_surface_variant"
                    android:textSize="15sp" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:background="@drawable/bg_tutorial_tip"
                    android:padding="12dp"
                    android:text="@string/tutorial_step_3_tip"
                    android:textColor="@color/m3_on_primary_container"
                    android:textSize="13sp" />

            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <com.google.android.material.card.MaterialCardView
                    android:layout_width="match_parent"
                    android:layout_height="184dp"
                    android:importantForAccessibility="noHideDescendants"
                    app:cardBackgroundColor="@color/m3_surface_variant"
                    app:cardCornerRadius="22dp"
                    app:cardElevation="0dp"
                    app:strokeColor="@color/m3_outline"
                    app:strokeWidth="1dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:orientation="vertical"
                        android:padding="14dp">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="36dp"
                            android:gravity="center_vertical"
                            android:orientation="horizontal">

                            <ImageView
                                android:layout_width="22dp"
                                android:layout_height="22dp"
                                android:contentDescription="@null"
                                android:src="@drawable/ic_arrow_back"
                                app:tint="@color/m3_on_surface_variant" />

                            <TextView
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="10dp"
                                android:layout_weight="1"
                                android:text="@string/tutorial_mock_folder_picker_title"
                                android:textColor="@color/m3_on_surface"
                                android:textSize="13sp"
                                android:textStyle="bold" />

                        </LinearLayout>

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="0dp"
                            android:layout_marginTop="6dp"
                            android:layout_weight="1"
                            android:background="@drawable/bg_tutorial_file_row"
                            android:gravity="center"
                            android:orientation="vertical">

                            <ImageView
                                android:layout_width="44dp"
                                android:layout_height="44dp"
                                android:contentDescription="@null"
                                android:src="@drawable/ic_folder"
                                app:tint="@color/m3_primary" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="6dp"
                                android:text="@string/tutorial_mock_games_folder"
                                android:textColor="@color/m3_on_surface"
                                android:textSize="12sp"
                                android:textStyle="bold" />

                        </LinearLayout>

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="36dp"
                            android:layout_marginTop="8dp"
                            android:background="@drawable/bg_tutorial_mock_button"
                            android:gravity="center"
                            android:text="@string/tutorial_mock_use_folder"
                            android:textColor="@color/m3_on_primary"
                            android:textSize="11sp"
                            android:textStyle="bold" />

                    </LinearLayout>

                </com.google.android.material.card.MaterialCardView>

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="18dp"
                    android:text="@string/tutorial_step_4_title"
                    android:textColor="@color/m3_on_surface"
                    android:textSize="21sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:lineSpacingExtra="2dp"
                    android:text="@string/tutorial_step_4_body"
                    android:textColor="@color/m3_on_surface_variant"
                    android:textSize="15sp" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:background="@drawable/bg_tutorial_tip"
                    android:padding="12dp"
                    android:text="@string/tutorial_step_4_tip"
                    android:textColor="@color/m3_on_primary_container"
                    android:textSize="13sp" />

            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <com.google.android.material.card.MaterialCardView
                    android:layout_width="match_parent"
                    android:layout_height="184dp"
                    android:importantForAccessibility="noHideDescendants"
                    app:cardBackgroundColor="@color/m3_surface_variant"
                    app:cardCornerRadius="22dp"
                    app:cardElevation="0dp"
                    app:strokeColor="@color/m3_outline"
                    app:strokeWidth="1dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:orientation="vertical"
                        android:padding="14dp">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="32dp"
                            android:gravity="center_vertical"
                            android:orientation="horizontal">

                            <TextView
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:text="@string/tutorial_mock_library_ready"
                                android:textColor="@color/m3_primary"
                                android:textSize="11sp"
                                android:textStyle="bold" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="@string/tutorial_mock_check"
                                android:textColor="@color/m3_primary"
                                android:textSize="18sp"
                                android:textStyle="bold" />

                        </LinearLayout>

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="58dp"
                            android:layout_marginTop="6dp"
                            android:background="@drawable/bg_tutorial_file_row"
                            android:gravity="center_vertical"
                            android:orientation="horizontal"
                            android:paddingHorizontal="10dp">

                            <TextView
                                android:layout_width="40dp"
                                android:layout_height="40dp"
                                android:background="@drawable/bg_tutorial_extension"
                                android:gravity="center"
                                android:text="@string/tutorial_mock_initial_adventure"
                                android:textColor="@color/m3_primary"
                                android:textSize="18sp"
                                android:textStyle="bold" />

                            <LinearLayout
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="10dp"
                                android:layout_weight="1"
                                android:orientation="vertical">

                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="@string/tutorial_mock_game_adventure"
                                    android:textColor="@color/m3_on_surface"
                                    android:textSize="12sp"
                                    android:textStyle="bold" />

                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:layout_marginTop="2dp"
                                    android:text="@string/tutorial_mock_engine_kristal"
                                    android:textColor="@color/m3_on_surface_variant"
                                    android:textSize="10sp" />

                            </LinearLayout>

                            <ImageView
                                android:layout_width="26dp"
                                android:layout_height="26dp"
                                android:background="@drawable/bg_tutorial_extension"
                                android:contentDescription="@null"
                                android:padding="6dp"
                                android:src="@drawable/ic_play"
                                app:tint="@color/m3_primary" />

                        </LinearLayout>

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="58dp"
                            android:layout_marginTop="6dp"
                            android:background="@drawable/bg_tutorial_file_row"
                            android:gravity="center_vertical"
                            android:orientation="horizontal"
                            android:paddingHorizontal="10dp">

                            <TextView
                                android:layout_width="40dp"
                                android:layout_height="40dp"
                                android:background="@drawable/bg_tutorial_extension"
                                android:gravity="center"
                                android:text="@string/tutorial_mock_initial_demo"
                                android:textColor="@color/m3_primary"
                                android:textSize="18sp"
                                android:textStyle="bold" />

                            <LinearLayout
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="10dp"
                                android:layout_weight="1"
                                android:orientation="vertical">

                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="@string/tutorial_mock_game_demo"
                                    android:textColor="@color/m3_on_surface"
                                    android:textSize="12sp"
                                    android:textStyle="bold" />

                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:layout_marginTop="2dp"
                                    android:text="@string/tutorial_mock_engine_kristal"
                                    android:textColor="@color/m3_on_surface_variant"
                                    android:textSize="10sp" />

                            </LinearLayout>

                            <ImageView
                                android:layout_width="26dp"
                                android:layout_height="26dp"
                                android:background="@drawable/bg_tutorial_extension"
                                android:contentDescription="@null"
                                android:padding="6dp"
                                android:src="@drawable/ic_play"
                                app:tint="@color/m3_primary" />

                        </LinearLayout>

                    </LinearLayout>

                </com.google.android.material.card.MaterialCardView>

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="18dp"
                    android:text="@string/tutorial_step_5_title"
                    android:textColor="@color/m3_on_surface"
                    android:textSize="21sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:lineSpacingExtra="2dp"
                    android:text="@string/tutorial_step_5_body"
                    android:textColor="@color/m3_on_surface_variant"
                    android:textSize="15sp" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:background="@drawable/bg_tutorial_tip"
                    android:padding="12dp"
                    android:text="@string/tutorial_step_5_tip"
                    android:textColor="@color/m3_on_primary_container"
                    android:textSize="13sp" />

            </LinearLayout>

    </ViewFlipper>

    <LinearLayout
        android:id="@+id/tutorialFooter"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingBottom="8dp">

        <LinearLayout
            android:id="@+id/tutorialDots"
            android:layout_width="match_parent"
            android:layout_height="18dp"
            android:layout_marginTop="12dp"
            android:gravity="center"
            android:orientation="horizontal" />

        <LinearLayout
            android:id="@+id/tutorialButtonRow"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnTutorialPrevious"
                style="@style/Widget.Material3.Button.TextButton"
                android:layout_width="wrap_content"
                android:layout_height="48dp"
                android:text="@string/tutorial_previous"
                android:textColor="@color/m3_on_surface_variant" />

            <Space
                android:layout_width="0dp"
                android:layout_height="1dp"
                android:layout_weight="1" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnTutorialNext"
                android:layout_width="wrap_content"
                android:layout_height="48dp"
                android:text="@string/tutorial_next"
                android:textColor="@color/m3_on_primary"
                app:backgroundTint="@color/m3_primary"
                app:cornerRadius="24dp"
                app:icon="@drawable/ic_chevron_right"
                app:iconGravity="textEnd"
                app:iconTint="@color/m3_on_primary" />

        </LinearLayout>

    </LinearLayout>

</LinearLayout>
