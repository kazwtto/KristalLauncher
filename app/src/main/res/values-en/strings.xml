    <!-- Compatibility patches -->
    <string name="action_patches">Patches</string>
    <string name="patches_settings_title">Compatibility patches</string>
    <string name="patches_settings_header">These are the global patches applied to all games by default. You can override them for specific games by tapping the gear icon in the games list.</string>

    <string name="patch_text_title">Accumulated Text Patch</string>
    <string name="patch_text_desc">Resolves an issue in Kristal Engine where battle texts (like \'The tutorial begins…?\') don\'t disappear when opening the menu, stacking on top of each other.\n\n⚠️ May occasionally cause minor visual text reloading on screen.</string>
    <string name="patch_text_warning">Disabling the Accumulated Text patch may leave old text fragments visible during dialogs in some games.\n\nAre you sure you want to disable it?</string>
    <string name="patch_fullscreen_title">Immersive Fullscreen</string>
    <string name="patch_fullscreen_desc">Forces the hiding of Android\'s navigation and status bars (immersive mode), allowing the game to use your device\'s full screen.</string>
    <string name="patch_shaders_title">Shaders Patch (GLSL ES Converter)</string>
    <string name="patch_shaders_desc">PC mod shaders often fail and cause a black screen on Android. This patch dynamically converts GLSL syntax to comply with strict OpenGL ES mobile rules.\n\n⚠️ Keep enabled unless the game completely loses color.</string>
    <string name="patch_shaders_warning">Disabling the GLSL ES shaders patch may cause black screens, freezes, or startup errors in most Kristal/LÖVE2D games on Android.\n\nAre you sure you want to disable it?</string>
    <string name="patch_gamepad_title">Virtual Touch Controls</string>
    <string name="patch_gamepad_desc">Injects a transparent virtual gamepad on the screen. Necessary if you don\'t have a physical controller connected.</string>
    <string name="patch_borders_title">Relative Borders Patch</string>
    <string name="patch_borders_desc">Many Kristal Engine mods use screen borders designed for fixed PC aspect ratios (4:3). This patch dynamically resizes borders so they don\'t get cut off on modern wide screens.</string>
    <string name="patch_rgba16_title">RGBA16 Conversion</string>
    <string name="patch_rgba16_desc">Android doesn\'t support 16-bit per channel images. This patch automatically converts affected images to 8-bit in memory to prevent crashes or black screens.</string>
    <string name="patch_physfs_title">PhysFS Anti-Crash (Stack Overflow)</string>
    <string name="patch_physfs_desc">LÖVE\'s virtual file search engine (PhysFS) can enter an infinite loop with certain mod paths. This patch imposes a safe limit to prevent crashes.</string>
    <string name="patch_nil_arithmetic_title">Nil Arithmetic &amp; Audio Sanitization</string>
    <string name="patch_nil_arithmetic_desc">Prevents the engine from immediately crashing (\'attempt to perform arithmetic on a nil value\') if a mod tries to manipulate the volume of a missing audio file.</string>

