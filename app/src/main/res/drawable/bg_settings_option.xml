<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_checked="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/m3_primary_container" />
            <stroke
                android:width="2dp"
                android:color="@color/m3_primary" />
            <corners android:radius="18dp" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/m3_surface_card" />
            <stroke
                android:width="1dp"
                android:color="@color/m3_outline" />
            <corners android:radius="18dp" />
        </shape>
    </item>
</selector>
