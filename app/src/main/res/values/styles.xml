<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="SettingsChoiceCard" parent="Widget.Material3.CardView.Filled">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">64dp</item>
        <item name="android:checkable">true</item>
        <item name="android:clickable">true</item>
        <item name="android:focusable">true</item>
        <item name="android:foreground">?attr/selectableItemBackground</item>
        <item name="cardBackgroundColor">@color/settings_choice_background</item>
        <item name="cardCornerRadius">16dp</item>
        <item name="cardElevation">0dp</item>
        <item name="checkedIcon">@null</item>
        <item name="strokeColor">@color/settings_choice_stroke</item>
        <item name="strokeWidth">1dp</item>
    </style>

    <style name="SettingsChoiceCard.Spaced">
        <item name="android:layout_marginTop">8dp</item>
    </style>

    <style name="SettingsChoiceRow">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">match_parent</item>
        <item name="android:gravity">center_vertical</item>
        <item name="android:orientation">horizontal</item>
        <item name="android:paddingStart">12dp</item>
        <item name="android:paddingEnd">12dp</item>
    </style>

    <style name="SettingsChoiceIcon">
        <item name="android:layout_width">40dp</item>
        <item name="android:layout_height">40dp</item>
        <item name="android:background">@drawable/bg_choice_icon_frame</item>
        <item name="android:padding">9dp</item>
        <item name="android:tint">@color/m3_primary</item>
    </style>

    <style name="SettingsChoiceCode">
        <item name="android:layout_width">40dp</item>
        <item name="android:layout_height">40dp</item>
        <item name="android:background">@drawable/bg_choice_icon_frame</item>
        <item name="android:gravity">center</item>
        <item name="android:textColor">@color/m3_primary</item>
        <item name="android:textSize">12sp</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style name="SettingsChoiceLabel">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginStart">14dp</item>
        <item name="android:layout_weight">1</item>
        <item name="android:textColor">@color/m3_on_surface</item>
        <item name="android:textSize">15sp</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style name="SettingsChoiceRadio" parent="Widget.Material3.CompoundButton.RadioButton">
        <item name="android:layout_width">40dp</item>
        <item name="android:layout_height">40dp</item>
        <item name="android:clickable">false</item>
        <item name="android:focusable">false</item>
        <item name="android:gravity">center</item>
        <item name="buttonTint">@color/m3_primary</item>
    </style>
</resources>
