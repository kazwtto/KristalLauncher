{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/kazwtto/KristalLauncher/blob/main/patches/schema/patch.schema.json",
  "title": "Kristal Launcher patch package",
  "type": "object",
  "additionalProperties": true,
  "required": [
    "schemaVersion",
    "id",
    "version",
    "name",
    "description",
    "author",
    "capabilities",
    "operations"
  ],
  "properties": {
    "schemaVersion": { "const": 1 },
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:[._-][a-z0-9]+)+$",
      "maxLength": 120
    },
    "version": { "type": "string", "pattern": "^[0-9]+(?:\\.[0-9]+){0,3}(?:-[0-9A-Za-z]+(?:[.-][0-9A-Za-z]+)*)?(?:\\+[0-9A-Za-z]+(?:[.-][0-9A-Za-z]+)*)?$", "maxLength": 64 },
    "name": { "$ref": "#/$defs/localizedText" },
    "description": { "$ref": "#/$defs/localizedText" },
    "useCases": {
      "type": "array",
      "maxItems": 16,
      "items": { "$ref": "#/$defs/localizedText" }
    },
    "author": { "type": "string", "minLength": 1, "maxLength": 160 },
    "category": { "type": "string", "default": "compatibility" },
    "minimumLauncherVersion": { "type": "string", "pattern": "^[0-9]+(?:\\.[0-9]+){0,3}(?:-[0-9A-Za-z]+(?:[.-][0-9A-Za-z]+)*)?(?:\\+[0-9A-Za-z]+(?:[.-][0-9A-Za-z]+)*)?$", "maxLength": 64 },
    "priority": { "type": "integer", "minimum": -10000, "maximum": 10000, "default": 100 },
    "capabilities": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "enum": ["staged_package", "inject_files", "edit_lua", "runtime_hook"]
      }
    },
    "dependencies": {
      "type": "array",
      "uniqueItems": true,
      "items": { "type": "string", "pattern": "^[a-z0-9]+(?:[._-][a-z0-9]+)+$", "maxLength": 120 }
    },
    "conflicts": {
      "type": "array",
      "uniqueItems": true,
      "items": { "type": "string", "pattern": "^[a-z0-9]+(?:[._-][a-z0-9]+)+$", "maxLength": 120 }
    },
    "operations": {
      "type": "array",
      "minItems": 1,
      "maxItems": 64,
      "items": { "$ref": "#/$defs/operation" }
    }
  },
  "$defs": {
    "localizedText": {
      "oneOf": [
        { "type": "string", "minLength": 1 },
        {
          "type": "object",
          "minProperties": 1,
          "additionalProperties": { "type": "string", "minLength": 1 }
        }
      ]
    },
    "safePath": {
      "type": "string",
      "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))(?!.*\\\\)(?!.*:)[^/]+(?:/[^/]+)*$"
    },
    "operation": {
      "type": "object",
      "required": ["type", "target"],
      "properties": {
        "type": { "enum": ["inject", "append_text", "replace_text"] },
        "source": {
          "allOf": [
            { "$ref": "#/$defs/safePath" },
            { "pattern": "^payload/" }
          ]
        },
        "target": { "$ref": "#/$defs/safePath" },
        "find": { "type": "string" },
        "replace": { "type": "string" },
        "replaceExisting": { "type": "boolean", "default": false },
        "required": { "type": "boolean", "default": true }
      }
    }
  }
}
