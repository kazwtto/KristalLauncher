{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/kazwtto/KristalLauncher/blob/main/patches/schema/catalog.schema.json",
  "title": "Kristal Launcher external patch catalog",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "patches"],
  "properties": {
    "$schema": { "type": "string" },
    "schemaVersion": { "const": 1 },
    "patches": {
      "type": "array",
      "maxItems": 200,
      "items": { "$ref": "#/$defs/catalogPatch" }
    }
  },
  "$defs": {
    "localizedText": {
      "oneOf": [
        { "type": "string", "minLength": 1 },
        {
          "type": "object",
          "minProperties": 1,
          "additionalProperties": { "type": "string", "minLength": 1 }
        }
      ]
    },
    "catalogPatch": {
      "type": "object",
      "additionalProperties": true,
      "required": [
        "schemaVersion",
        "id",
        "version",
        "name",
        "description",
        "author",
        "capabilities",
        "package",
        "sha256"
      ],
      "properties": {
        "schemaVersion": { "const": 1 },
        "id": {
          "type": "string",
          "pattern": "^[a-z0-9]+(?:[._-][a-z0-9]+)+$",
          "maxLength": 120
        },
        "version": { "type": "string", "pattern": "^[0-9]+(?:\\.[0-9]+){0,3}(?:-[0-9A-Za-z]+(?:[.-][0-9A-Za-z]+)*)?(?:\\+[0-9A-Za-z]+(?:[.-][0-9A-Za-z]+)*)?$", "maxLength": 64 },
        "name": { "$ref": "#/$defs/localizedText" },
        "description": { "$ref": "#/$defs/localizedText" },
        "useCases": {
          "type": "array",
          "maxItems": 16,
          "items": { "$ref": "#/$defs/localizedText" }
        },
        "releaseNotes": { "$ref": "#/$defs/localizedText" },
        "author": { "type": "string", "minLength": 1, "maxLength": 160 },
        "category": { "type": "string" },
        "minimumLauncherVersion": { "type": "string", "pattern": "^[0-9]+(?:\\.[0-9]+){0,3}(?:-[0-9A-Za-z]+(?:[.-][0-9A-Za-z]+)*)?(?:\\+[0-9A-Za-z]+(?:[.-][0-9A-Za-z]+)*)?$", "maxLength": 64 },
        "priority": { "type": "integer" },
        "capabilities": { "type": "array", "items": { "type": "string" } },
        "dependencies": { "type": "array", "items": { "type": "string", "pattern": "^[a-z0-9]+(?:[._-][a-z0-9]+)+$", "maxLength": 120 } },
        "conflicts": { "type": "array", "items": { "type": "string", "pattern": "^[a-z0-9]+(?:[._-][a-z0-9]+)+$", "maxLength": 120 } },
        "package": {
          "type": "string",
          "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))(?!.*\\\\)(?!.*:)[^/]+(?:/[^/]+)*\\.klpatch$"
        },
        "sha256": { "type": "string", "pattern": "^[a-fA-F0-9]{64}$" }
      }
    }
  }
}
